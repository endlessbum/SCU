<UserControl
             x:Class="SCU.Views.Sections.InputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SCU.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="860">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
            <StackPanel Grid.Row="1" Margin="0">
                <ItemsControl Margin="0" ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- PinCard.CardId задаёт скрепке id закрепления; пусто у
                                 непинируемых строк — глиф скрыт триггером стиля. -->
                            <ContentControl Style="{StaticResource SwitchRowCard}"
                                            controls:PinCard.CardId="{Binding PinCardId}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Карточка «Перевод раскладки»: автоисправление ввода в неверной раскладке. -->
                <Border Style="{StaticResource SectionCard}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource RowHeaderText}"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{DynamicResource S_LayoutTranslatorTitle}" />
                                <controls:InfoGlyph Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    InfoText="{DynamicResource S_LayoutTranslatorInfo}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource RowActionText}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="{DynamicResource S_LayoutTranslatorDesc}" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource SystemToggleSwitch}"
                                      AutomationProperties.Name="{DynamicResource S_LayoutTranslatorTitle}"
                                      IsChecked="{Binding LayoutTranslatorOn, Mode=OneWay}"
                                      IsEnabled="{Binding DataContext.IsTranslatorInteractive, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      Command="{Binding DataContext.SetLayoutTranslatorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                      ToolTip="{DynamicResource S_LayoutTranslatorConfirm}"
                                      ToolTipService.ShowOnDisabled="True" />
                    </Grid>
                </Border>

                <!-- Настройки ручной конвертации, исключений и уведомлений переводчика. -->
                <Border Style="{StaticResource SectionCard}" Margin="0,8,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowHeaderText}"
                                       VerticalAlignment="Center"
                                       Text="{DynamicResource S_LayoutTranslatorHotKeyLabel}" />
                            <ComboBox Grid.Column="1" Margin="12,0,0,0" MinWidth="220"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding ManualHotKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Tag="Pause" Content="{DynamicResource S_LayoutTranslatorHotKeyPause}" />
                                <ComboBoxItem Tag="Ctrl+Alt+P" Content="{DynamicResource S_LayoutTranslatorHotKeyCtrlAltP}" />
                            </ComboBox>
                        </Grid>
                        <TextBlock Style="{StaticResource RowActionText}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{DynamicResource S_LayoutTranslatorHotKeyHelp}"
                                   Margin="0,0,0,8" />
                        <CheckBox Content="{DynamicResource S_LayoutTranslatorToastLabel}"
                                  IsChecked="{Binding ShowCorrectionToast, Mode=TwoWay}"
                                  Margin="0,0,0,10" />
                        <TextBlock Style="{StaticResource RowHeaderText}"
                                   Text="{DynamicResource S_LayoutTranslatorExceptionsLabel}" />
                        <DockPanel Margin="0,6,0,6">
                            <Button DockPanel.Dock="Right" Margin="8,0,0,0"
                                    Content="{DynamicResource S_LayoutTranslatorAddException}"
                                    Command="{Binding AddTranslatorExceptionCommand}"
                                    Style="{StaticResource AccentButton}" />
                            <TextBox MinWidth="200" VerticalContentAlignment="Center"
                                     Text="{Binding CustomExceptionDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{DynamicResource S_LayoutTranslatorExceptionPlaceholder}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding TranslatorCustomExceptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,3" Margin="0,0,6,6"
                                            Background="{DynamicResource ControlFillBrush}" CornerRadius="10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                            <Button Content="×" Margin="6,0,0,0" Padding="4,0" MinWidth="0"
                                                    ToolTip="{DynamicResource S_LayoutTranslatorRemoveException}"
                                                    Command="{Binding DataContext.RemoveTranslatorExceptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Сноска к карточкам со звёздочкой (ускорение мыши, залипание клавиш):
                     ON у этих тумблеров означает отключение системного параметра. -->
                <TextBlock Margin="0,2,0,0"
                           Text="{DynamicResource S_InputAsteriskNote}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

        <!-- Пустой список настроек -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,24,0,8">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Style="{StaticResource EmptyStateIcon}" Text="&#xE946;" />
            <TextBlock Style="{StaticResource EmptyStateText}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Text="{DynamicResource S_EmptyState}" />
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock Style="{StaticResource SectionStatusText}" Text="{Binding StatusText}" />
            <TextBlock Style="{StaticResource SectionWarnText}" Text="{Binding ReadOnlyHint}" />
        </StackPanel>
    
</Grid>
</UserControl>
