<UserControl x:Class="SCU.Views.Sections.DefenderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SCU.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Карточка «Защитник Windows»: выключатель Defender на уровне системы.
             Информер ⓘ перенесён из шапки раздела внутрь карточки — справа от
             названия, как у остальных карточек. -->
        <StackPanel Grid.Row="0">
            <Border Style="{StaticResource SectionCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource RowHeaderText}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{DynamicResource S_DefenderCardTitle}" />
                            <controls:InfoGlyph Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                InfoText="{DynamicResource I_DefenderCard}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource RowActionText}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{DynamicResource S_DefenderCardDesc}" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource SystemToggleSwitch}"
                                  AutomationProperties.Name="{DynamicResource S_DefenderCardTitle}"
                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  IsEnabled="{Binding DataContext.IsInteractive, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  ToolTip="{DynamicResource S_DefenderToggleTip}"
                                  ToolTipService.ShowOnDisabled="True" />
                </Grid>
            </Border>

            <!-- Сноска: выключение не удаляет Defender, включение возвращает политику и службы -->
            <TextBlock Margin="0,2,0,0"
                       Text="{DynamicResource S_DefenderNote}"
                       Style="{StaticResource CaptionText}" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Style="{StaticResource SectionStatusText}" Text="{Binding StatusText}" />
            <TextBlock Style="{StaticResource SectionWarnText}" Text="{Binding ReadOnlyHint}" />
        </StackPanel>

    </Grid>
</UserControl>
