<UserControl x:Class="SCU.Views.Cards.NetworkNduCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SCU.Views.Controls">
    <Border Style="{StaticResource SectionCard}">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource BodyStrongText}" Text="{DynamicResource S_NetNduTitle}" />
                <controls:InfoGlyph x:Name="NduInfoGlyph" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Style="{StaticResource CardIntroText}"
                       TextWrapping="Wrap"
                       Text="{DynamicResource S_NetNduDesc}" />
            <!-- Тумблер: включен — сбор статистики идёт, выключен — отключён.
                 Состояние не прочитано (ActiveNduKey=null) — тумблер отключён. -->
            <ToggleButton Margin="0,8,0,0"
                          HorizontalAlignment="Left"
                          Style="{StaticResource SystemToggleSwitch}"
                          AutomationProperties.Name="{DynamicResource S_NetNduTitle}"
                          IsChecked="{Binding IsNduEnabled, Mode=OneWay}"
                          Command="{Binding NduToggleCommand}" />
        </StackPanel>
    </Border>
</UserControl>
