<Application x:Class="SCU.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sections="clr-namespace:SCU.Views.Sections"
             xmlns:vms="clr-namespace:SCU.ViewModels.Sections"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Стартовый словарь; ThemeManager подменяет его на Colors.Dark/Light по настройке -->
                <ResourceDictionary Source="Themes/Colors.Light.xaml" />
                <!-- Стартовый словарь строк; Localization подменяет его по выбранному языку -->
                <ResourceDictionary Source="Themes/Strings.ru.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Глобальные DataTemplate для связи ViewModel и View -->
            <DataTemplate DataType="{x:Type vms:InfoViewModel}">
                <sections:InfoView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vms:ComponentsViewModel}">
                <sections:ComponentsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vms:StartupViewModel}">
                <sections:StartupView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
